# Server-only environment variables. Never use NEXT_PUBLIC_ for credentials.
NOTION_TOKEN=
NOTION_LINKS_DB_ID=
NOTION_CATEGORIES_DB_ID=
NOTION_WEBSITE_CONFIG_ID=
REVALIDATE_TIME=300

# Primary: Zhipu GLM-4.7-Flash. Backup: SiliconFlow; called only after primary failure.
# Keep both keys server-side. With neither key configured, manual capture remains available.
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=XingChenAGI/Xing4.0-29B
# Legacy custom provider, used only when neither of the provider keys above is set.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Public news uses source excerpts by default. Enable only after setting provider limits.
AI_NEWS_ENABLED=0
