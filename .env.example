# Server-only environment variables. Never use NEXT_PUBLIC_ for credentials.
NOTION_TOKEN=
NOTION_LINKS_DB_ID=
NOTION_CATEGORIES_DB_ID=
NOTION_WEBSITE_CONFIG_ID=
REVALIDATE_TIME=300

# Optional model provider selected by the owner; HTTPS endpoint ending in /v1/.
# AI stays visibly unavailable until all three values are present.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Public news uses source excerpts by default. Enable only after setting provider limits.
AI_NEWS_ENABLED=0
